; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HiveClient"
run/main_scene="uid://xskrcots3rci"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DatabaseManager="*uid://ch5t1hp4oohjt"
Nakama="*uid://ckho07ucaxkun"
Secrets="*uid://dofsr0rfp4j6"
OnlineManager="*uid://bbjq6cjlo1pvb"
Events="*uid://cubqdy5xq2vl6"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/context_generator/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://translations/translations_block.en.translation", "res://translations/translations_block.pl.translation", "res://translations/translations_brain_editor.en.translation", "res://translations/translations_brain_editor.pl.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
